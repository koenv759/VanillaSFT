# Copy to `.env` and fill in for your environment. `.env` is git-ignored.
# The training/eval SLURM scripts `source .env` for all machine-specific paths.

# --- Interpreters (point at a venv that has ms-swift + torch + qwen-omni-utils) ---
PYTHON=python                 # python interpreter used for eval scripts
SWIFT_BIN=swift               # ms-swift `swift` entrypoint used for training

# --- Base model ---
# HF id (auto-downloaded) or a local snapshot dir. Overrides the yaml `model:` field.
BASE_MODEL=Qwen/Qwen2.5-Omni-7B

# --- Caches ---
HF_HOME=$HOME/.cache/huggingface

# --- IntentBench (HF: PhilipC/IntentBench) — a dir with qa.json + videos/ ---
IB_QA=/path/to/IntentBench/qa.json
IB_VIDEOS=/path/to/IntentBench/videos

# --- Daily-Omni (HF: liarliar/Daily-Omni) ---
DAILY_QA=/path/to/daily_omni/qa.json
DAILY_VIDEOS=/path/to/daily_omni

# --- WorldSense (HF: honglyhly/WorldSense) ---
WORLD_QA=/path/to/worldsense/worldsense_qa.json
WORLD_VIDEOS=/path/to/worldsense

# --- Cluster module loads (optional; edit for your site, or leave blank) ---
# Example (Jean-Zay H100): "arch/h100 anaconda-py3 ffmpeg"
CLUSTER_MODULES=
